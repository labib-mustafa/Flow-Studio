{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Main Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      }
    },
    {
      "label": "Start Dialogs Watcher",
      "type": "shell",
      "command": "node watch.cjs",
      "options": {
        "cwd": "${workspaceFolder}/Test it First/Custom Dialogs"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      }
    }
  ]
}
